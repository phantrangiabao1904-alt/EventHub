@model List<ServiceOption>
@{ ViewBag.Title = "Dịch vụ đi kèm"; }
<div class="card"><div class="card-header d-flex flex-wrap justify-content-between align-items-center"><h2 class="card-title mb-0">Danh mục dịch vụ</h2><a class="btn btn-primary btn-sm" href="@Url.Action("Create")"><i class="fas fa-plus mr-1" aria-hidden="true"></i> Thêm dịch vụ</a></div><div class="card-body table-responsive p-0"><table class="table table-hover">
    <thead><tr><th>Tên dịch vụ</th><th>Mô tả</th><th>Đơn giá</th><th>Trạng thái</th><th></th></tr></thead><tbody>
    @foreach (var item in Model)
    {
        <tr><td class="font-weight-bold">@item.Name</td><td>@item.Description</td><td class="text-right">@Vi.Money(item.UnitPrice)</td><td><span class="badge badge-@(item.IsActive ? "success" : "secondary")">@(item.IsActive ? "Đang cung cấp" : "Ngừng cung cấp")</span></td><td><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.Id })">Sửa</a></td></tr>
    }
    </tbody>
</table></div><div class="card-footer text-muted small">Ngừng cung cấp để ẩn dịch vụ khỏi đơn mới. Thông tin trên đơn cũ được giữ nguyên.</div></div>
