@model DepositSettingsViewModel
<section class="card card-outline card-primary mt-3" id="deposit-settings">
<div class="card-header"><h2 class="card-title">Quản lý % cọc và QR chuyển khoản mặc định</h2></div>
<div class="card-body">
    @using (Html.BeginForm("SaveDepositSettings", "Dashboard", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-6">
                <div class="form-group"><label for="defaultPercent">Tỷ lệ cọc (%)</label><input id="defaultPercent" name="Percent" type="number" min="1" max="100" step="0.01" value="@Model.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required /></div>
            </div>
            <div class="col-md-6">
                <label for="defaultQrFile">Ảnh QR (JPEG/PNG, tối đa 3 MB)</label>
                <input id="defaultQrFile" type="file" name="qrFile" class="form-control-file mb-3" accept="image/jpeg,image/png" />
                @if (!string.IsNullOrEmpty(Model.QrImageUrl)) { <img id="defaultQrPreview" src="@Url.Content(Model.QrImageUrl)" alt="QR cọc mặc định" style="max-width:280px;width:100%;height:auto" /> }
                else { <img id="defaultQrPreview" alt="Xem trước QR" style="display:none;max-width:280px;width:100%;height:auto" /> }
            </div>
        </div>
        <p class="text-muted">Cấu hình này dùng cho các yêu cầu gửi tiếp theo. Không tự thay QR hoặc % cọc trên đơn đã gửi cho khách. Để trống ảnh để giữ QR hiện tại. Kiểm tra số tiền và nội dung chuyển khoản nếu ảnh QR của bạn có sẵn giá trị cố định.</p>
        <button class="btn btn-primary" type="submit">Lưu % cọc và QR mặc định</button>
    }
</div></section>
<script>
document.getElementById('defaultQrFile').addEventListener('change', function () {
    if (!this.files.length) return;
    if (this.files[0].size > 3 * 1024 * 1024) { alert('Ảnh tối đa 3 MB.'); this.value = ''; return; }
    var reader = new FileReader(); reader.onload = function () { var image = document.getElementById('defaultQrPreview'); image.src = reader.result; image.style.display = ''; }; reader.readAsDataURL(this.files[0]);
});
</script>
