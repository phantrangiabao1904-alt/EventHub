@model MonthlyReportViewModel
@{ ViewBag.Title = "Báo cáo tháng"; }
<div class="card"><div class="card-body">
    @using (Html.BeginForm("Index", "Reports", FormMethod.Get, new { @class = "form-inline" }))
    {
        <label for="month" class="mr-2">Tháng</label><input id="month" name="month" type="number" min="1" max="12" value="@Model.Month" class="form-control mr-3" required />
        <label for="year" class="mr-2">Năm</label><input id="year" name="year" type="number" min="2000" max="2100" value="@Model.Year" class="form-control mr-3" required />
        <button class="btn btn-primary mr-2" type="submit">Xem báo cáo</button>
        <a class="btn btn-success" href="@Url.Action("Export", new { month = Model.Month, year = Model.Year })">Tải Excel (.xlsx)</a>
    }
    <p class="text-muted mt-3 mb-0">Thống kê theo <strong>ngày tổ chức</strong> trong tháng @Model.Month/@Model.Year. Giá trị đơn đã xác nhận/hoàn thành không phải số tiền đã thu.</p>
</div></div>
<div class="row">
    <div class="col-md-3"><div class="small-box bg-info"><div class="inner"><h3>@Model.Bookings.Count</h3><p>Tổng số đơn</p></div></div></div>
    <div class="col-md-3"><div class="small-box bg-warning"><div class="inner"><h3>@Model.CancellationRate.ToString("0.0")%</h3><p>Tỷ lệ hủy (@Model.Cancelled đơn)</p></div></div></div>
    <div class="col-md-6"><div class="small-box bg-success"><div class="inner"><h3>@Vi.Money(Model.ContractValue)</h3><p>Giá trị đơn xác nhận / hoàn thành</p></div></div></div>
</div>
<div class="card"><div class="card-body">
    <p>Chờ duyệt: <strong>@Model.Pending</strong> · Chờ cọc: <strong>@Model.AwaitingDeposit</strong> · Đặt thành công: <strong>@Model.Confirmed</strong> · Hoàn thành: <strong>@Model.Completed</strong> · Đã hủy: <strong>@Model.Cancelled</strong></p>
    <p>Phiếu ghi nhận trong tháng: Thu <strong>@Vi.Money(Model.Receipts)</strong> · Hoàn <strong>@Vi.Money(Model.Refunds)</strong> · Thu ròng <strong>@Vi.Money(Model.NetCollected)</strong>.</p>
    <p class="small text-muted">Thu/hoàn tính theo ngày ghi nhận phiếu, có thể thuộc đơn tổ chức ở tháng khác.</p>
    <h2 class="h5 mt-4 mb-3">Địa điểm được đặt nhiều (không tính đơn hủy)</h2>
    @if (!Model.TopVenues.Any()) { <p class="text-muted">Chưa có dữ liệu trong tháng này.</p> }
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Địa điểm</th><th>Số đơn</th><th>Giá trị xác nhận/hoàn thành</th></tr></thead><tbody>
    @foreach (var venue in Model.TopVenues) { <tr><td>@venue.Name</td><td>@venue.Count</td><td>@Vi.Money(venue.Value)</td></tr> }
    </tbody></table></div>
</div></div>
