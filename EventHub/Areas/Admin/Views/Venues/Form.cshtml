@model VenueFormViewModel
@{ ViewBag.Title = Model.Id == 0 ? "Thêm địa điểm" : "Chỉnh sửa địa điểm"; }

<div class="row">
    <div class="col-lg-8">
        <div class="card card-primary">
            <div class="card-header"><h3 class="card-title">Thông tin địa điểm</h3></div>
            @using (Html.BeginForm(Model.Id == 0 ? "Create" : "Edit", "Venues", new { id = Model.Id == 0 ? (int?)null : Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <div class="card-body">
                    @Html.ValidationSummary(true, null, new { @class = "alert alert-danger" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.Name)
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Description)
                        @Html.TextAreaFor(m => m.Description, 3, 0, new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Address)
                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            @Html.LabelFor(m => m.Capacity)
                            @Html.TextBoxFor(m => m.Capacity, new { @class = "form-control", type = "number", min = 1 })
                            @Html.ValidationMessageFor(m => m.Capacity, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 form-group">
                            @Html.LabelFor(m => m.Price)
                            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", min = 0, step = 1000 })
                            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.Status)
                        @Html.DropDownListFor(m => m.Status, Vi.VenueStatusOptions(Model.Status.ToString()), new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.ImageUrl)
                        @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", placeholder = "https://..." })
                        @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger" })
                        <label for="imageFile" class="mt-3">Hoặc tải ảnh từ máy</label>
                        <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/jpeg,image/png" />
                        @Html.ValidationMessage("imageFile", new { @class = "text-danger" })
                        <small class="form-text text-muted">JPEG/PNG, tối đa 3 MB. Ảnh tải lên thay thế đường dẫn ảnh; để trống để giữ ảnh hiện tại.</small>
                        <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : Url.Content(Model.ImageUrl))" alt="Xem trước ảnh địa điểm" style="max-width:100%;max-height:240px;@(string.IsNullOrEmpty(Model.ImageUrl) ? "display:none" : "")" class="mt-3 rounded" />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
                    <a href="@Url.Action("Index", "Venues")" class="btn btn-default">Hủy</a>
                </div>
            }
        </div>
    </div>
</div>
@section scripts {
<script>
document.getElementById('imageFile').addEventListener('change', function () {
    var image = document.getElementById('imagePreview');
    if (!this.files.length) { image.src = image.dataset.original || ''; image.style.display = image.dataset.original ? '' : 'none'; return; }
    var file = this.files[0];
    if (file.size > 3 * 1024 * 1024) { alert('Ảnh tối đa 3 MB.'); this.value = ''; image.src = image.dataset.original || ''; image.style.display = image.dataset.original ? '' : 'none'; return; }
    var reader = new FileReader();
    reader.onload = function () { image.src = reader.result; image.style.display = ''; };
    reader.readAsDataURL(file);
});
document.getElementById('imagePreview').dataset.original = document.getElementById('imagePreview').getAttribute('src');
</script>
}
