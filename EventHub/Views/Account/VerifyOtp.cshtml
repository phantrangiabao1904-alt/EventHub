@model VerifyOtpViewModel
@{ ViewBag.Title = "Xác thực email"; }

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="step-icon"><i class="bi bi-envelope-check"></i></div>
                    <h1 class="h3 mt-3">Xác thực email</h1>
                    <p class="text-muted mb-0">Mã gồm 6 chữ số đã được gửi tới <strong>@ViewData["MaskedEmail"]</strong>.<br />Mã có hiệu lực trong @ViewData["Minutes"] phút.</p>
                </div>

                @using (Html.BeginForm("VerifyOtp", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Email)
                    @Html.ValidationSummary(true, null, new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.TextBoxFor(m => m.Code, new { @class = "form-control form-control-lg text-center", maxlength = 6, inputmode = "numeric", autocomplete = "one-time-code", placeholder = "••••••", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small" })
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Xác nhận</button>
                }

                <hr />
                @using (Html.BeginForm("ResendOtp", "Account", FormMethod.Post, new { @class = "text-center" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" value="@Model.Email" />
                    <span class="text-muted small">Không nhận được mã?</span>
                    <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">Gửi lại mã</button>
                }
                <div class="text-center mt-2 small"><a href="@Url.Action("Register", "Account")">Dùng email khác</a></div>
            </div>
        </div>
    </div>
</div>
