@model BookingCreateViewModel
@{ ViewBag.Title = "Đặt địa điểm"; }

<nav class="breadcrumb" aria-label="Đường dẫn"><a class="breadcrumb-item" href="@Url.Action("Index", "Venues")">Địa điểm</a><a class="breadcrumb-item" href="@Url.Action("Details", "Venues", new { id = Model.VenueId })">@Model.VenueName</a><span class="breadcrumb-item active" aria-current="page">Gửi yêu cầu</span></nav>
<div class="booking-journey" aria-label="Quy trình đặt chỗ"><span class="journey-step"><b>1</b><strong>Gửi yêu cầu</strong></span><i class="bi bi-arrow-right" aria-hidden="true"></i><span class="journey-step"><b>2</b>Nhận QR cọc</span><i class="bi bi-arrow-right" aria-hidden="true"></i><span class="journey-step"><b>3</b>Nhân viên xác nhận cọc</span><i class="bi bi-arrow-right" aria-hidden="true"></i><span class="journey-step"><b>4</b>Đặt thành công</span></div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-uppercase text-warning fw-semibold small">Đặt chỗ</div>
                <h1 class="h3">Đặt địa điểm: @Model.VenueName</h1>
                <p class="text-muted">Gửi yêu cầu thuê để nhân viên duyệt và gửi QR cọc. Đơn chỉ đặt thành công sau khi nhân viên đối chiếu và xác nhận đã nhận đủ cọc.</p>

                @using (Html.BeginForm("Create", "Bookings", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.VenueId)
                    @Html.ValidationSummary(true, null, new { @class = "alert alert-danger" })

                    if (Model.Services.Count > 0)
                    {
                        <fieldset class="border rounded p-3 mb-4"><legend class="float-none w-auto fs-6 px-2">Dịch vụ đi kèm (tùy chọn)</legend>
                        @for (var i = 0; i < Model.Services.Count; i++)
                        {
                            <div class="service-choice row align-items-center mb-3" data-price="@Model.Services[i].UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                @Html.HiddenFor(m => m.Services[i].ServiceOptionId)
                                <div class="col-8"><label>@Html.CheckBoxFor(m => m.Services[i].Selected) @Model.Services[i].Name · @Vi.Money(Model.Services[i].UnitPrice) / đơn vị</label><div class="small text-muted">@Model.Services[i].Description</div></div>
                                <div class="col-4">@Html.TextBoxFor(m => m.Services[i].Quantity, new { @class = "form-control", type = "number", min = 1, max = 10000, aria_label = "Số lượng " + Model.Services[i].Name })</div>
                            </div>
                        }
                        <p class="small text-muted mb-0">Giá chính thức được tính trên máy chủ khi gửi yêu cầu. Bạn có thể bỏ chọn mọi dịch vụ.</p>
                        </fieldset>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.EventDate, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EventDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", min = DateTime.Today.ToString("yyyy-MM-dd") })
                            @Html.ValidationMessageFor(m => m.EventDate, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.GuestCount, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.GuestCount, new { @class = "form-control", type = "number", min = 1, max = Model.VenueCapacity })
                            @Html.ValidationMessageFor(m => m.GuestCount, "", new { @class = "text-danger small" })
                            <div class="form-text">Tối đa @Model.VenueCapacity khách.</div>
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.StartTime, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.StartTime, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                            @Html.ValidationMessageFor(m => m.StartTime, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.EndTime, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EndTime, "{0:hh\\:mm}", new { @class = "form-control", type = "time" })
                            @Html.ValidationMessageFor(m => m.EndTime, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-12">
                            @Html.LabelFor(m => m.Notes, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.Notes, 4, 0, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <div id="bookingTotals" class="alert alert-info w-100" data-rental="@Model.VenuePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-deposit="@Model.DepositPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            Tổng dự kiến: <strong id="totalPreview">@Vi.Money(Model.VenuePrice)</strong> · Cọc dự kiến: <strong id="depositPreview"></strong>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Gửi yêu cầu đặt chỗ</button>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Details", "Venues", new { id = Model.VenueId })">Quay lại</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            @if (!string.IsNullOrEmpty(Model.VenueImageUrl))
            {
                <img src="@Model.VenueImageUrl" class="card-img-top" alt="@Model.VenueName" />
            }
            <div class="card-body">
                <h2 class="h5">@Model.VenueName</h2>
                <ul class="list-unstyled mb-0">
                    <li class="mb-1"><i class="bi bi-people"></i> Tối đa @Model.VenueCapacity khách</li>
                    <li><i class="bi bi-cash-coin"></i> Giá thuê: <strong class="text-primary">@Vi.Money(Model.VenuePrice)</strong> / sự kiện</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@section scripts {
<script>
(function () {
    var summary = document.getElementById('bookingTotals');
    function updateTotal() {
        var total = Number(summary.dataset.rental);
        document.querySelectorAll('.service-choice').forEach(function (row) {
            var selected = row.querySelector('input[type=checkbox]');
            var quantity = row.querySelector('input[type=number]');
            if (selected.checked) total += Number(row.dataset.price) * Math.max(1, Number(quantity.value) || 1);
        });
        var format = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });
        document.getElementById('totalPreview').textContent = format.format(total);
        document.getElementById('depositPreview').textContent = format.format(Math.round(total * Number(summary.dataset.deposit) / 100));
    }
    document.querySelectorAll('.service-choice input').forEach(function (input) { input.addEventListener('input', updateTotal); });
    updateTotal();
})();
</script>
}
